{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/polling-cron",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/live-cron",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/live-cron",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/live-cron",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/live-cron",
      "schedule": "0 19 * * *"
    }
  ],
  "functions": {
    "api/polling.ts": {
      "maxDuration": 60
    },
    "api/polling-cron.ts": {
      "maxDuration": 60
    },
    "api/live-cron.ts": {
      "maxDuration": 60
    }
  }
}
